Пояснения к HTML

    data-letter="alef" — это пользовательский атрибут. Он хранит «ключ» буквы. JS берёт этот ключ и ищет по нему описание. В будущем этот же ключ будет передаваться в запросе к Java: fetch('/api/letter/alef').
    id="contentPlaceholder" — это блок, куда JS будет вставлять текст. Пустой изначально, заполняется при клике.
    id="loadingIndicator" — индикатор загрузки. Сейчас он имитирует задержку сети. Когда подключишь Java, он будет показываться, пока ждёшь ответ от сервера.
    <script src="js/script.js"></script> стоит в конце <body> — это правило: сначала загрузится весь HTML, потом скрипт. Иначе скрипт не найдёт элементы, к которым привязывается.

Часть 3. css/style.css

css

/* === Переменные цветов === */
/* Используем CSS-переменные: удобно менять цветовую схему в одном месте */
:root {
  --bg: #f9f9f9;       /* фон страницы */
  --panel: #ffffff;    /* фон боковой панели */
  --accent: #2b5a80;   /* акцентный цвет (заголовки) */
  --text: #333;        /* основной текст */
  --hover: #f0f0f0;    /* фон при наведении */
}

/* === Сброс и базовые стили === */
body {
  margin: 0;
  padding: 0;
  font-family: Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  height: 100vh;        /* на всю высоту экрана */
  display: flex;        /* flexbox: sidebar слева, main-content справа */
  overflow: hidden;     /* скролл только внутри панелей, не на всей странице */
}

/* === Левая панель (навигация) === */
.sidebar {
  width: 280px;
  background: var(--panel);
  border-right: 1px solid #ddd;
  display: flex;
  flex-direction: column;
  padding-top: 16px;
  overflow-y: auto;     /* если букв много — появляется скролл */
  flex-shrink: 0;       /* панель не сжимается при уменьшении экрана */
}

/* === Кнопка «Еврейский алфавит» === */
.main-toggle {
  background: none;
  border: 1px solid #ccc;
  width: calc(100% - 24px);    /* ширина с отступами по бокам */
  margin: 0 12px 16px 12px;
  text-align: left;
  padding: 12px 16px;
  cursor: pointer;
  font-size: 15px;
  color: var(--text);
  border-radius: 6px;
  display: flex;               /* flebox внутри кнопки */
  align-items: center;
  gap: 8px;                    /* отступ между текстом и стрелкой */
}

.main-toggle:hover {
  border-color: var(--accent);
  background: var(--hover);
}

/* === Стрелка-индикатор === */
.arrow-main {
  font-size: 12px;
  transition: transform 0.3s ease;   /* плавный поворот */
}

/* Класс .rotated добавляется JS — стрелка переворачивается */
.arrow-main.rotated {
  transform: rotate(180deg);
}

/* === Список букв (аккордеон) === */
/* Закрытое состояние: высота 0, содержимое скрыто */
.letters-list {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  padding: 0 12px;
}

/* Открытое состояние: JS добавляет класс .open */
.letters-list.open {
  max-height: 500px;           /* достаточно для всех букв */
  padding: 0 12px 16px 12px;
}

/* === Строка буквы === */
.letter-row {
  display: flex;
  align-items: center;
  margin-bottom: 4px;
  cursor: pointer;             /* показывает, что кликабельно */
  padding: 6px 0;
}

.letter-row:hover {
  background: #f5f5f5;
}

/* Сам символ буквы (крупный) */
.letter-symbol {
  font-size: 20px;
  font-weight: bold;
  min-width: 24px;
  text-align: center;
}

/* Название буквы (текст) */
.letter-name {
  flex: 1;                     /* занимает всё оставшееся место */
  font-size: 14px;
}

/* === Правая панель (контент) === */
.main-content {
  flex: 1;                     /* занимает всё оставшееся место */
  padding: 32px;
  overflow-y: auto;             /* скролл, если текст длинный */
}

h1 {
  margin: 0 0 20px 0;
  font-size: 24px;
  color: var(--accent);
}

p {
  line-height: 1.6;
  max-width: 700px;            /* текст не растягивается на весь экран */
}

/* Индикатор загрузки (скрыт по умолчанию) */
.loading-indicator {
  display: none;
  color: #888;
  font-style: italic;
}

/* === Адаптивность для телефона === */
@media (max-width: 768px) {
  body {
    flex-direction: column;     /* панель не слева, а сверху */
  }
  .sidebar {
    width: 100%;
    border-right: none;
    border-bottom: 1px solid #ddd;
    max-height: 50vh;           /* панель занимает пол-экрана */
  }
  .main-content {
    padding: 20px;
  }
}

Пояснения к CSS

    max-height: 0 + overflow: hidden — это основа аккордеона. Блок существует, но его высота равна нулю, поэтому содержимое не видно. Когда JS добавляет класс .open, max-height становится 500px — и блок плавно раскрывается.
    transition — анимация. Без неё блок бы появлялся/исчезал мгновенно. С ней — плавно за 0.3 секунды.
    flex и flex: 1 — flexbox раскладка. Sidebar имеет фиксированную ширину (280px), а .main-content через flex: 1 занимает всё остальное место. Это автоматически подстраивается под любой размер экрана.
    @media (max-width: 768px) — медиазапрос. На экранах уже 768px (телефоны) макет меняется: панель перемещается наверх, а контент — под неё.

Часть 4. js/script.js

javascript

document.addEventListener('DOMContentLoaded', () => {
  // === Получаем ссылки на элементы страницы ===
  const mainToggle = document.getElementById('alphabetToggle');
  const lettersList = document.getElementById('lettersList');
  const arrowMain = mainToggle.querySelector('.arrow-main');
  const contentPlaceholder = document.getElementById('contentPlaceholder');
  const loadingIndicator = document.getElementById('loadingIndicator');

  // === Имитация базы данных ===
  // Сейчас тексты хранятся прямо в JS-объекте.
  // В будущем это заменится на запрос к Java: fetch('/api/letter/alef')
  const letterData = {
    alef:  '<strong>Алеф (א)</strong> — первая буква еврейского алфавита. ' +
           'В современном иврите часто не произносится, но может обозначать ' +
           'гортанную смычку. В гематрии — 1.',

    bet:   '<strong>Бет (ב)</strong> — вторая буква. Звук [б] или [в] ' +
           'в зависимости от дагеша. Числовое значение — 2.',

    gimel: '<strong>Гимель (ג)</strong> — третья буква, звук [г]. ' +
           'Числовое значение — 3.',

    dalet: '<strong>Далет (ד)</strong> — четвёртая буква, звук [д]. ' +
           'Числовое значение — 4.',

    hei:   '<strong>Хе (ה)</strong> — пятая буква, звук [х] или [h]. ' +
           'Числовое значение — 5.',

    vav:   '<strong>Вав (ו)</strong> — шестая буква, звук [в] или [у]. ' +
           'Числовое значение — 6.',

    zayin: '<strong>Зайин (ז)</strong> — седьмая буква, звук [з]. ' +
           'Числовое значение — 7.',

    chet:  '<strong>Хет (ח)</strong> — восьмая буква, гортанный звук [х]. ' +
           'Числовое значение — 8.',

    tet:   '<strong>Тет (ט)</strong> — девятая буква, звук [т]. ' +
           'Числовое значение — 9.',

    yod:   '<strong>Йод (י)</strong> — десятая буква, звук [й]. ' +
           'Числовое значение — 10.'
  };

  // =====================================================
  //   ГЛАВНОЕ МЕСТО ДЛЯ БУДУЩЕЙ JAVA-ИНТЕГРАЦИИ
  // =====================================================
  // Сейчас getLetterData берёт текст из JS-объекта.
  // Когда будет Java-бэкенд, эта функция заменяется на fetch().
  //
  // async/await — это современный способ работы с асинхронными
  // операциями (запросы к серверу). Не блокирует страницу,
  // пока ждёт ответ.
  // =====================================================
  async function getLetterData(key) {
    // --- Вариант 1 (сейчас): данные из JS-объекта ---
    return letterData[key];

    // --- Вариант 2 (будущее): запрос к Java-бэкенду ---
    // Раскомментировать, когда Spring Boot будет готов:
    //
    // const response = await fetch(`/api/letter/${key}`);
    // const data = await response.json();
    // return data.content;
  }

  // =====================================================
  //   ЛОГИКА: раскрытие/закрытие списка букв
  // =====================================================
  mainToggle.addEventListener('click', () => {
    const isOpen = lettersList.classList.contains('open');

    if (!isOpen) {
      // Открываем список
      lettersList.classList.add('open');
      arrowMain.classList.add('rotated');  // стрелка переворачивается
    } else {
      // Закрываем список
      lettersList.classList.remove('open');
      arrowMain.classList.remove('rotated');
      // Сбрасываем контент справа
      contentPlaceholder.innerHTML = 'Выберите букву слева, чтобы увидеть описание.';
    }
  });

  // =====================================================
  //   ЛОГИКА: клик по букве → описание справа
  // =====================================================
  // forEach проходит по всем .letter-row и вешает
  // обработчик клика на каждый.
  document.querySelectorAll('.letter-row').forEach(row => {
    row.addEventListener('click', async () => {
      // data-letter="alef" → получаем "alef"
      const key = row.getAttribute('data-letter');
      await showContent(key);
    });
  });

  // =====================================================
  //   ФУНКЦИЯ: показать контент в правой панели
  // =====================================================
  async function showContent(key) {
    // Показываем индикатор загрузки
    loadingIndicator.style.display = 'block';
    contentPlaceholder.style.opacity = '0.6';  // приглушаем старый текст

    try {
      // Получаем данные (из JS сейчас, из Java — потом)
      const content = await getLetterData(key);

      if (content) {
        // Вставляем HTML в блок (innerHTML позволяет теги <strong> и т.д.)
        contentPlaceholder.innerHTML = content;
      } else {
        contentPlaceholder.innerHTML = '<strong>Данные не найдены</strong>.';
      }
    } catch (error) {
      // Если что-то пошло не так (в будущем — ошибка сети/сервера)
      console.error('Ошибка загрузки данных:', error);
      contentPlaceholder.innerHTML = '<strong>Ошибка при загрузке данных.</strong>';
    } finally {
      // finally выполняется ВСЕГДА — и при успехе, и при ошибке
      loadingIndicator.style.display = 'none';
      contentPlaceholder.style.opacity = '1';
    }
  }
});

Пояснения к JavaScript
Концепция	Что делает	Зачем важно
DOMContentLoaded	ждёт, пока вся страница загрузится	скрипт не запустится раньше, чем появятся элементы
addEventListener('click', ...)	вешает обработчик клика	основа всей интерактивности
classList.add / remove	добавляет/убирает CSS-класс	так JS управляет внешним видом без изменения CSS
data-letter + getAttribute	читает ключ буквы	связывает HTML с данными
async / await	асинхронный вызов	не блокирует страницу, пока ждёт данные
try / catch / finally	обработка ошибок	если сервер упадёт — пользователь увидит сообщение, а не белый экран
innerHTML	вставляет HTML-код в элемент	позволяет использовать теги <strong>, <p> и т.д. в текстах
